{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "outputDirectory": "dist/kinsa-carta/browser",
  "rewrites": [
    {
      "source": "/administrar",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://carta-digital-kinsa-api.vercel.app/api/:path*"
    }
  ]
}
